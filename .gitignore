# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
coverage/
*.tgz

# Environment — keep the example, ignore real env files
.env*
!.env.example

# Local databases, WAL/SHM, and any snapshot/export — runtime telemetry, never commit
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
exports/

# Local working notes — excluded from the repo and the in-app docs build.
# Anything a contributor drafts here (specs, plans, audit write-ups) stays on
# their machine; only finished docs under docs/ are published.
docs/_local/
audits/
specs/
plans/
*.audit.md
*.local.md

# Assistant / agent workspaces. Regenerated by local tooling on any clone or CI
# runner, hold per-developer configuration and scratch state, never committed.
# Additional per-developer tool directories belong in .git/info/exclude, which
# stays local to a clone — this file is public, so it names only the universal ones.
.claude/
CLAUDE.md
CLAUDE.local.md

# Local supplement to the secret scanner — machine-specific literals to block.
# Personal by definition, so it is loaded from disk and never committed.
scripts/.scan-local.json

# Server- and build-generated artifacts
rules-enforcement.json
enforce-config.json
rules.json
protected-paths.json

# Images and screenshots — keep them out of the repository
*.png
*.jpg
*.jpeg
*.gif
.screenshots/
screenshots/

# OS / editor noise
.DS_Store
*.log
