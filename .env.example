# ── ClaudeSec Environment Variables ──────────────────────────────────────
# All variables are optional — sensible defaults are used when unset.

# ── Server ──────────────────────────────────────────────────────────────
CLAUDESEC_PORT=3000
# PORT=3000                         # Fallback alias for CLAUDESEC_PORT (CLAUDESEC_PORT takes precedence)
# CLAUDESEC_HOST=127.0.0.1          # Bind address; set to 0.0.0.0 to expose to the network
                                    # (requires CLAUDESEC_TOKEN when non-loopback)

# ── Authentication ───────────────────────────────────────────────────────
# Bearer token required for non-loopback API / MCP / OTLP access.
# Also required to bind a non-loopback CLAUDESEC_HOST (server refuses to start otherwise).
# Leave unset for normal local use (loopback is always exempt).
# CLAUDESEC_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────
# The database defaults to ~/.claudesec/spans.db — an absolute path, so it no
# longer depends on the directory the server happens to be started from.
# Upgrading from 1.3.0 or earlier: a spans.db left in your checkout is moved
# into the new location automatically on first start, once, and only when the
# new location is still empty and CLAUDESEC_DB is not set.
# CLAUDESEC_DB=~/.claudesec/spans.db  # SQLite path; point throwaway/test instances elsewhere
# CLAUDESEC_HOME=~/.claudesec       # State dir: hooks/, the audit signing key, the signed
                                    # hash-chain anchor and the pairing key. Back this up WITH
                                    # the database — the chain can't be verified without it.
# CLAUDESEC_MAX_ATTR_BYTES=4096     # Per-attribute value cap on write, in bytes (values above this are truncated)
# In Docker the image points both at the mounted volume (/data/spans.db and
# /data/claudesec). Moving them outside /data puts your history back inside the
# container's disposable layer, where the next image upgrade destroys it.

# ── Retention ───────────────────────────────────────────────────────────
# The two knobs below are set together as a retention profile (see
# docs/explanation/retention.mdx) so the span ceiling can never fall below the
# day window's own volume and silently stop ingestion. Defaults are the
# "Minimum" profile — a six-month window a normal workload can actually reach.
# CLAUDESEC_MAX_SPANS=1000000      # Max spans before out-of-window spans are pruned; 0 = unbounded
# CLAUDESEC_RETENTION_DAYS=183     # Delete spans older than N days; 0 = unbounded

# ── Rate limiting (per IP on /v1/traces) ────────────────────────────────
CLAUDESEC_RATE_LIMIT_RPS=50        # Requests per second
CLAUDESEC_RATE_LIMIT_BURST=200     # Burst capacity
CLAUDESEC_MAX_SPANS_BATCH=500      # Max spans per single POST

# ── CORS and proxy ───────────────────────────────────────────────────────
# CLAUDESEC_CORS_ORIGINS=http://example.com  # Comma-separated allowed origins (beyond loopback defaults)
# CLAUDESEC_TRUST_PROXY=1           # Trust X-Forwarded-For headers; only set behind a reverse proxy

# ── Transcript watcher ───────────────────────────────────────────────────
# CLAUDESEC_WATCH=0                 # Set to 0 to disable the zero-config transcript watcher
# CLAUDESEC_BACKFILL=1              # Set to 1 to replay existing transcripts on startup
# CLAUDESEC_MCP_SCAN_ROOTS=/path/one:/path/two  # Override default MCP scanner roots (colon/comma-separated)

# ── Webhook alerts ──────────────────────────────────────────────────────
# CLAUDESEC_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...
# CLAUDESEC_WEBHOOK_THRESHOLD=high   # Minimum severity: low | medium | high

# ── OTLP trace forwarding (transparent proxy) ──────────────────────────
# Forward all ingested traces to an upstream OTLP collector
# OTEL_FORWARD_URL=http://localhost:4318/v1/traces

# ── Custom rules and auto-export ────────────────────────────────────────
# CLAUDESEC_RULES_FILE=./rules.json     # Custom detection rules (Docker: /data/rules.json)
# CLAUDESEC_AUTO_EXPORT=1               # Enable hourly JSON auto-export (also on-demand via POST /api/export)
# CLAUDESEC_AUTO_EXPORT_DIR=./exports   # Hourly JSON snapshots (last 24 kept)

# ── External audit anchoring (off by default) ────────────────────────────
# Timestamp the signed audit-chain anchor with an independent third party, so
# the anchor's own creation time can't be backdated by whoever controls this
# host. Off unless CLAUDESEC_ANCHOR_METHOD is explicitly set.
# CLAUDESEC_ANCHOR_METHOD=tsa           # tsa (RFC 3161) | ots (OpenTimestamps); unset = off
# CLAUDESEC_ANCHOR_TSA_URL=http://timestamp.digicert.com   # RFC 3161 timestamp authority
# CLAUDESEC_ANCHOR_OTS_URL=             # Comma-separated OpenTimestamps calendar servers (defaults to the reference client's three)
# CLAUDESEC_ANCHOR_INTERVAL_MS=900000   # How often to re-anchor (min 60000; default 15 min)
# CLAUDESEC_ANCHOR_TIMEOUT_MS=10000     # Per-request timeout (capped at 60000)

# ── Security controls ────────────────────────────────────────────────────
# CLAUDESEC_ALLOW_RESET=1           # Must be 1 to permit POST /api/reset (data-wipe disabled by default)
# CLAUDESEC_DISABLE_SCRUB=1         # Set to 1 to disable secret scrubbing before storage/broadcast (not recommended)
# CLAUDESEC_HONEYTOKENS=token1,token2  # Canary strings; an alert fires if any appears in a span

# ── Enforcement hook ─────────────────────────────────────────────────────
# CLAUDESEC_MODE=monitor            # Enforcement mode: monitor (default, logs only) | enforce (blocks)
# CLAUDESEC_ENFORCE_CONFIG=./enforce-config.json  # Path to the mirrored enforce-config.json the hook reads
# CLAUDESEC_ENFORCE_RULES=./rules-enforcement.json  # Path to compiled block-rule snapshot
# CLAUDESEC_HOOKS_BYPASS=1          # Set to 1 to allow all tool calls for one invocation (escape hatch)

# ── LLM-as-judge semantic detection (local-first, off by default) ────────
# Point at a local Ollama or LM Studio instance; no data leaves your machine unless
# you configure a remote URL.
# CLAUDESEC_JUDGE_URL=http://localhost:11434/v1  # OpenAI-compatible /chat/completions endpoint
# CLAUDESEC_JUDGE_MODEL=llama3.1    # Model name passed to the judge endpoint
# CLAUDESEC_JUDGE_KEY=              # Optional bearer key (not needed for local Ollama)
# CLAUDESEC_JUDGE_TIMEOUT_MS=10000  # Request timeout in milliseconds (default: 10000)
